# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o exemplo, que é justamente o que ajuda quem clona o projeto
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos de agente de IA
# CLAUDE.md e AGENTS.md são gerados automaticamente pelo `next dev` a cada
# execução — não são código do projeto e recriam sozinhos se apagados.
CLAUDE.md
AGENTS.md
# configuração local do Claude Code (só vale nesta máquina)
.claude/

